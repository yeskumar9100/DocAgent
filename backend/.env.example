# ── DocAgent Environment Variables ──────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts all API keys stored in the database.
# If you lose it, stored keys become unrecoverable.
SECRET_KEY=REPLACE_ME_generate_with_command_above

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./docagent.db

# ── Default Provider (works out of the box) ───────────────────────────────────
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# ── Optional Providers (add via Settings UI or directly here) ─────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...

# ── App Settings ──────────────────────────────────────────────────────────────
FAISS_INDEX_DIR=./faiss_indexes
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
